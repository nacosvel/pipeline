{
    "name": "nacosvel/pipeline",
    "description": "The Nacosvel Components",
    "keywords": [
        "nacosvel",
        "pipeline"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/nacosvel/pipeline",
    "authors": [
        {
            "name": "jundayw",
            "email": "jundayw@126.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "nacosvel/macroable": "^1.0",
        "psr/container": "^1.1.1|^2.0.1"
    },
    "autoload": {
        "psr-4": {
            "Nacosvel\\Pipeline\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
